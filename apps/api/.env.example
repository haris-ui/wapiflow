# WapiFlow API Configuration

# Application
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=wapiflow-production-super-secret-key-32-bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","https://wapiflow.com"]

# Database (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wapiflow

# Supabase Auth & JWT
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Cloudflare R2 Storage
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=wapiflow-assets
R2_PUBLIC_URL=https://assets.wapiflow.com

# Meta WhatsApp Cloud API
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=wapiflow_webhook_verify_token
META_WHATSAPP_API_VERSION=v19.0

# Redis / ARQ Worker
REDIS_URL=redis://localhost:6379/0

# Resend Email API
RESEND_API_KEY=re_your_resend_api_key
