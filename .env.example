# ==============================================================================
# WapiFlow Monorepo Environment Configuration Template
# Duplicate this file to .env and provide appropriate credentials for your environment.
# NEVER commit real credentials, API keys, or secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Supabase project URL (e.g., https://your-project-ref.supabase.co or http://localhost:54321 for local)
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anonymous public API key (safe for client-side usage)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Supabase service role secret key (Bypasses RLS - BACKEND WORKERS ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
# Direct PostgreSQL connection string for migrations and backend asyncpg pooler (port 6543 for transaction pooler or 5432 for session)
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# Backend API Configuration (FastAPI)
# ------------------------------------------------------------------------------
# Secret key for server-side cryptographic operations (generate via `openssl rand -hex 32`)
BACKEND_SECRET_KEY=generate_a_secure_random_64_character_hex_string_here
# Comma-separated list of allowed CORS origins
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://app.wapiflow.com
# Debug mode flag (set to false in production)
DEBUG=false
# Application logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Redis (Job Queue ARQ / Rate Limiter / Cache)
# ------------------------------------------------------------------------------
# Redis connection URL (e.g., redis://localhost:6379/0 or rediss://default:password@host:port for managed Redis)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Cloudflare R2 (S3-Compatible Object Storage)
# ------------------------------------------------------------------------------
# Cloudflare account ID (found in Cloudflare dashboard URL or R2 overview)
R2_ACCOUNT_ID=your_cloudflare_account_id
# R2 API token Access Key ID
R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2 API token Secret Access Key
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# Name of the R2 bucket for attachments, invoices, and product catalog media
R2_BUCKET_NAME=wapiflow-media-production
# Public custom domain or r2.dev URL mapped to bucket
R2_PUBLIC_URL=https://media.wapiflow.com

# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# ------------------------------------------------------------------------------
# Meta App ID from Meta App Dashboard
META_APP_ID=123456789012345
# Meta App Secret (Used to compute HMAC-SHA256 signature for webhook payload verification)
META_APP_SECRET=your_meta_app_secret_hash
# Secret token configured in the Meta webhook verification setup
META_VERIFY_TOKEN=your_custom_secure_webhook_verify_token
# Graph API Version targeted by outbound messages and webhook schemas
META_WHATSAPP_API_VERSION=v20.0

# ------------------------------------------------------------------------------
# Resend (Transactional Email Service)
# ------------------------------------------------------------------------------
# Resend API key for order confirmations, notifications, and onboarding alerts
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz
# Verified sending email address
RESEND_FROM_EMAIL=WapiFlow Notifications <notifications@wapiflow.com>

# ------------------------------------------------------------------------------
# Sentry (Error Tracking & Performance Monitoring)
# ------------------------------------------------------------------------------
# Backend Sentry DSN
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# Frontend Configuration (React 18 + Vite)
# ------------------------------------------------------------------------------
# Supabase project URL accessible by frontend browser client
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anonymous public API key for browser client authentication
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder
# Base URL for the FastAPI backend API
VITE_API_URL=http://localhost:8000
# Application display branding
VITE_APP_NAME=WapiFlow
# Frontend Sentry DSN for client-side exception capture
VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
